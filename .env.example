# .env — API Keys
# NEVER commit this file to git. Add .env to your .gitignore!

# ── Binance TESTNET (paper trading) ─────────────────────────────────────────
# Get these from: https://testnet.binance.vision
BINANCE_TESTNET_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET=your_testnet_secret_here

# ── Binance LIVE (real money) ────────────────────────────────────────────────
# Get these from: https://www.binance.com/en/my/settings/api-management
# Recommended permissions: Enable Reading + Enable Spot & Margin Trading only
# Restrict to your IP address for safety
BINANCE_LIVE_KEY=your_live_api_key_here
BINANCE_LIVE_SECRET=your_live_secret_here

# ── FreeCryptoAPI (price momentum signal) ───────────────────────────────────
# Get your key at: https://freecryptoapi.com/panel
# Used for 24h price change data — complements text-based news sentiment
FREECRYPTOAPI_KEY=

# ── CryptoPanic news API (optional) ─────────────────────────────────────────
# Free key raises rate limit from 5 to 50 requests/minute
# Get one at: https://cryptopanic.com/developers/api/
# Leave blank to use the public feed (no key required)
CRYPTOPANIC_KEY=
